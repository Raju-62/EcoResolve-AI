#!/bin/sh
# EcoResolve Maven Wrapper launcher
MAVEN_VERSION="3.9.16"
MAVEN_HOME_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_HOME_DIR/apache-maven-$MAVEN_VERSION/bin/mvn"
MAVEN_ZIP="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION-bin.zip"
MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip"

if [ ! -x "$MAVEN_BIN" ]; then
  echo "Maven $MAVEN_VERSION is not installed locally. Downloading it now..."
  mkdir -p "$MAVEN_HOME_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$MAVEN_URL" -o "$MAVEN_ZIP" || exit 1
  else
    wget -O "$MAVEN_ZIP" "$MAVEN_URL" || exit 1
  fi
  unzip -q -o "$MAVEN_ZIP" -d "$MAVEN_HOME_DIR" || exit 1
  rm -f "$MAVEN_ZIP"
fi

exec "$MAVEN_BIN" "$@"
